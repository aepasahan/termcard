{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "io.github.aepasahan/termcard",
  "title": "Termcard",
  "description": "Create terminal business cards (npx <name>) in a chat, or look up anyone's card.",
  "websiteUrl": "https://termcard.dev",
  "repository": {
    "url": "https://github.com/aepasahan/termcard",
    "source": "github",
    "subfolder": "packages/termcard"
  },
  "version": "0.6.1",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "termcard",
      "version": "0.6.1",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.termcard.dev/mcp"
    }
  ]
}
