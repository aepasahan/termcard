{
  "name": "termcard-monorepo",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "termcard-monorepo",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=18.18"
      }
    },
    "node_modules/create-termcard": {
      "resolved": "packages/create-termcard",
      "link": true
    },
    "node_modules/termcard": {
      "resolved": "packages/termcard",
      "link": true
    },
    "packages/create-termcard": {
      "version": "0.1.0",
      "license": "UNLICENSED",
      "dependencies": {
        "termcard": "^0.1.0"
      },
      "bin": {
        "create-termcard": "bin/create-termcard.js"
      },
      "engines": {
        "node": ">=18.18"
      }
    },
    "packages/termcard": {
      "version": "0.1.0",
      "license": "UNLICENSED",
      "bin": {
        "termcard": "bin/termcard.js"
      },
      "engines": {
        "node": ">=18.18"
      }
    }
  }
}
